{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kofte:module-manifest:1",
  "title": "Köfte module manifest schema 1",
  "description": "Structural checks only. Complete acceptance also requires raw-input budgets, strict parsing and semantic/contextual validation; never fetch manifest references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "displayName",
    "hostContract",
    "capabilities",
    "dependencies",
    "permissions",
    "storage"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "id": {
      "$ref": "#/$defs/moduleId"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "displayName": {
      "$ref": "#/$defs/displayName"
    },
    "hostContract": {
      "$ref": "#/$defs/range"
    },
    "capabilities": {
      "type": "array",
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "contractVersion"],
        "properties": {
          "kind": {
            "enum": [
              "backend",
              "frontend",
              "resources",
              "providers",
              "events",
              "workflows",
              "jobs",
              "permissions",
              "mcp-tools"
            ]
          },
          "contractVersion": {
            "$ref": "#/$defs/version"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "versionRange"],
        "properties": {
          "id": {
            "$ref": "#/$defs/moduleId"
          },
          "versionRange": {
            "$ref": "#/$defs/range"
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9]*)*(?![\\s\\S])"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relational"],
      "properties": {
        "relational": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "moduleId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?){2,}(?![\\s\\S])"
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
    },
    "range": {
      "type": "string",
      "minLength": 5,
      "maxLength": 512,
      "description": "Coarse structural syntax only. SemVer endpoints, interval ordering and prerelease/host compatibility require the semantic validator.",
      "pattern": "^(?:[0-9][0-9A-Za-z.+-]*|(?:>=|>)[0-9][0-9A-Za-z.+-]* (?:<=|<)[0-9][0-9A-Za-z.+-]*)(?![\\s\\S])"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
    }
  }
}
