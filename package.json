{
  "name": "kofte",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/bootstrap-contract",
    "tests/contract",
    "tests/e2e"
  ],
  "engines": {
    "node": "24.22.0",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "overrides": {
    "@playwright/test": "1.65.0-alpha-2026-10-29",
    "playwright-core": "1.65.0-alpha-2026-10-29"
  },
  "scripts": {
    "format:check": "prettier --check \"{apps/web,packages/bootstrap-contract,tests/contract,tests/e2e}/**/*.{ts,tsx,json,css,mjs}\" \"*.json\" \"*.mjs\" \"scripts/*.mjs\"",
    "format": "prettier --write \"{apps/web,packages/bootstrap-contract,tests/contract,tests/e2e}/**/*.{ts,tsx,json,css,mjs}\" \"*.json\" \"*.mjs\" \"scripts/*.mjs\"",
    "contract:check": "node scripts/check-contract.mjs",
    "dependencies:check": "python3 scripts/check_dependencies.py --prepare-bundled-evidence",
    "verify": "python3 scripts/verify.py"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript-eslint": "8.72.0",
    "typescript": "6.0.3",
    "prettier": "3.9.10",
    "vitest": "5.0.5",
    "vite": "7.3.7",
    "jsdom": "30.1.3"
  }
}
