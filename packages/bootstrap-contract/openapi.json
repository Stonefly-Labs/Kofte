{
  "openapi": "3.1.1",
  "info": {
    "title": "Köfte Bootstrap API",
    "description": "Bootstrap-v1 health and host identity-v1. No domain operation or module/MCP interface.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5080"
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Observe process liveness without checking storage",
        "operationId": "bootstrapLiveness",
        "responses": {
          "200": {
            "description": "Process can serve the liveness request",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveStatus"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidHealthRequest"
          },
          "405": {
            "description": "Unsupported method; empty response body",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            }
          }
        },
        "security": []
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Observe current selected-provider readiness without caching",
        "operationId": "bootstrapReadiness",
        "responses": {
          "200": {
            "description": "Configured platform store is usable",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyStatus"
                }
              }
            }
          },
          "503": {
            "description": "Startup incomplete or platform store unavailable; no provider fallback",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnavailableStatus"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidHealthRequest"
          },
          "405": {
            "description": "Unsupported method; empty response body",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            }
          }
        },
        "security": []
      }
    },
