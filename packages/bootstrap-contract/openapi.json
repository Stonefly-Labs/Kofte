          "503": {
            "description": "Fixed sanitized identity failure",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "Pragma": {
                "required": true,
                "schema": {
                  "const": "no-cache",
                  "type": "string"
                }
              },
              "Referrer-Policy": {
                "required": true,
                "schema": {
                  "const": "no-referrer",
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemV1"
                }
              }
            }
          },
          "200": {
            "description": "Verified self identity or public browser continuity",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "Pragma": {
                "required": true,
                "schema": {
                  "const": "no-cache",
                  "type": "string"
                }
              },
              "Referrer-Policy": {
                "required": true,
                "schema": {
                  "const": "no-referrer",
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrowserContextV1"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/identity/v1/me": {
      "get": {
