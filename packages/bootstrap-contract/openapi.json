        "security": [
          {
            "kofteSession": []
          }
        ]
      }
    },
    "/openapi/v1.json": {
      "get": {
        "summary": "Fetch this versioned contract in Development only",
        "operationId": "bootstrapOpenApi",
        "responses": {
          "200": {
            "description": "OpenAPI description, available only in Development",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "required": [
                    "openapi",
                    "info",
                    "paths"
                  ],
                  "type": "object",
                  "properties": {
                    "openapi": {
                      "const": "3.1.1",
                      "type": "string"
                    },
                    "info": {
                      "required": [
                        "title",
                        "version"
                      ],
                      "type": "object",
                      "properties": {
                        "title": {
                          "const": "Köfte Bootstrap API",
                          "type": "string"
                        },
                        "version": {
                          "const": "1.0.0",
                          "type": "string"
                        }
                      }
                    },
                    "paths": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidHealthRequest"
          },
          "404": {
            "description": "Documentation route absent outside Development; empty response body"
          },
          "405": {
            "description": "Unsupported method; empty response body",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "BrowserContextV1": {
        "required": [
          "version",
          "identityMode",
          "csrfToken"
        ],
        "type": "object",
        "properties": {
          "version": {
            "const": "1",
            "type": "string"
          },
          "identityMode": {
            "enum": [
              "oidc",
              "development"
            ],
            "type": "string"
          },
          "csrfToken": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CorrelationId": {
        "pattern": "^[0-9a-f]{32}$",
        "type": "string"
      },
      "CurrentIdentityV1": {
        "required": [
          "version",
          "userId",
          "displayName",
          "identityMode",
          "isInitialAdministrator"
        ],
        "type": "object",
        "properties": {
          "version": {
            "const": "1",
            "type": "string"
          },
          "userId": {
            "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "maxLength": 128,
            "type": [
              "null",
              "string"
            ]
          },
          "identityMode": {
            "enum": [
              "oidc",
              "development"
            ],
            "type": "string"
          },
          "isInitialAdministrator": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "IdentityProblemV1": {
        "required": [
          "type",
          "title",
          "status",
          "code",
          "correlationId"
        ],
        "type": "object",
        "properties": {
          "type": {
            "pattern": "^urn:kofte:problem:identity_",
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "enum": [
              "identity_request_invalid",
              "identity_unauthenticated",
              "identity_forbidden",
              "identity_enrollment_unavailable",
              "identity_admission_exceeded",
              "identity_unavailable",
              "identity_outcome_uncertain"
            ],
            "type": "string"
          },
          "correlationId": {
            "$ref": "#/components/schemas/CorrelationId"
          }
        },
        "additionalProperties": false
      },
      "LiveStatus": {
        "required": [
          "version",
          "state",
          "component",
          "correlationId"
        ],
        "type": "object",
        "properties": {
          "version": {
            "const": "1",
            "type": "string"
          },
          "state": {
            "const": "live",
            "type": "string"
          },
          "component": {
            "const": "host",
            "type": "string"
          },
          "correlationId": {
            "$ref": "#/components/schemas/CorrelationId"
          }
        },
        "additionalProperties": false
      },
      "ReadyStatus": {
        "required": [
          "version",
          "state",
          "component",
          "correlationId"
        ],
        "type": "object",
        "properties": {
          "version": {
            "const": "1",
            "type": "string"
          },
          "state": {
            "const": "ready",
            "type": "string"
          },
          "component": {
            "const": "storage",
            "type": "string"
          },
          "correlationId": {
            "$ref": "#/components/schemas/CorrelationId"
          }
        },
        "additionalProperties": false
      },
      "UnavailableStatus": {
        "required": [
          "version",
          "state",
          "component",
          "correlationId"
        ],
        "type": "object",
        "properties": {
          "version": {
            "const": "1",
            "type": "string"
          },
          "state": {
            "const": "unavailable",
            "type": "string"
          },
          "component": {
            "enum": [
              "host",
              "storage"
            ],
            "type": "string"
          },
          "correlationId": {
            "$ref": "#/components/schemas/CorrelationId"
          }
        },
        "additionalProperties": false
      }
    },
    "responses": {
      "InvalidHealthRequest": {
        "description": "Unsupported query or request body; empty sanitized response",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        }
      }
    },
    "headers": {
      "NoStore": {
        "description": "Do not cache diagnostic responses",
        "required": true,
        "schema": {
          "const": "no-store",
          "type": "string"
        }
      }
    },
    "securitySchemes": {
      "kofteSession": {
        "type": "apiKey",
        "description": "Opaque host session cookie; no Authorization or bearer-token credential.",
        "name": "kofte-dev-session",
        "in": "cookie"
      }
    }
  },
  "security": []
}
